  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@earendil-works/pi-tui": "^1.0.1",
    "typebox": "^1.3.27"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "typebox": "1.3.27",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
